{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["Kernel.php"]
    },
    "logs": {
        "text": "var/infection.log"
    },
    "minMsi": 85,
    "minCoveredMsi": 90,
    "threads": "max",
    "phpUnit": {
        "configDir": "."
    }
}
