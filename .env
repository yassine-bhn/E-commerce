# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> ecommerce-core (INF-002) ###
# Host port published by compose.yaml. 8080 is used by another local project.
APP_PORT=8081
###< ecommerce-core (INF-002) ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# INF-001: PostgreSQL 16 only (dev, test, prod). server_version also set in config/packages/doctrine.yaml.
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> ecommerce-core / ECO-008 ###
MEILISEARCH_URL=http://127.0.0.1:7700
###< ecommerce-core / ECO-008 ###

###> storefront cors ###
# Comma-separated list of allowed storefront origins (CORS with credentials).
STOREFRONT_CORS_ORIGIN=http://localhost:3000
###< storefront cors ###

###> storefront app url ###
# Base URL of the storefront, used to build the password reset link.
STOREFRONT_APP_URL=http://localhost:3000
###< storefront app url ###

###> whatsapp contact ###
# Contact answered by GET /api/v1/storefront/contact/whatsapp. Digits only, international format:
# no spaces, no special characters; an optional single leading "+" is accepted and stripped.
# Placeholder — replace with the real WhatsApp Business number per environment.
WHATSAPP_PHONE_NUMBER=21600000000
# Message prefilled in the wa.me link when no contextual message is supplied.
WHATSAPP_DEFAULT_MESSAGE="Hello, I would like more information about your products."
###< whatsapp contact ###

###> remember me ###
# Lifetime in seconds of the "remember me" cookie issued by a ticked login (default: 14 days).
REMEMBER_ME_LIFETIME=1209600
###< remember me ###

###> google oauth ###
# Google Cloud OAuth 2.0 client used by /api/v1/auth/google. Leave empty to disable the flow (endpoints answer 503).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/api/v1/auth/google/callback
###< google oauth ###
