includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 8
    paths:
        - src
        - tests
services:
    -
        class: Agents\PhpStan\HandlerReturnVoidRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\NoWriteInQueryHandlerRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\NoEventBusInCommandHandlerRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\NoFloatInDomainRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\NoInfrastructureInHandlerRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\NoDoctrineInApplicationRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\ControllerThinRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\OneHandlerPerClassRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\InterfaceMethodLimitRule
        tags:
            - phpstan.rules.rule
    -
        class: Agents\PhpStan\ConstructorDependencyLimitRule
        tags:
            - phpstan.rules.rule
