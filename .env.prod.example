# Production stack configuration (R13). Copy to .env.prod on the server and fill every value.
# .env.prod is git-ignored and must never be committed (SEC-005).
# Usage: docker compose --env-file .env.prod -f compose.prod.yaml config

# --- Domains / TLS (Caddy ACME needs 80/443 reachable and the DNS record in place) ---
APP_DOMAIN=api.example.com
STOREFRONT_DOMAIN=shop.example.com
EDGE_EMAIL=ops@example.com

# --- Application ---
# 32+ random characters: `openssl rand -hex 32`
APP_SECRET=change-me-32-random-characters
MAILER_DSN=null://null
STOREFRONT_CORS_ORIGIN=https://shop.example.com
STOREFRONT_APP_URL=https://shop.example.com
# Lifetime in seconds of the "remember me" cookie issued by a ticked login (default: 14 days).
REMEMBER_ME_LIFETIME=1209600
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
# Ranges of the proxy in front of the app (compose network + host reverse proxies).
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# --- WhatsApp contact (GET /api/v1/storefront/contact/whatsapp) ---
# Digits only, international format: no spaces, no special characters; an optional single leading
# "+" is accepted. MUST be replaced with the real WhatsApp Business number — the placeholder below
# is not a working number and no chat will reach anyone.
WHATSAPP_PHONE_NUMBER=21600000000
# Message prefilled in the wa.me link when the storefront sends no contextual message.
# Declare it but leave it empty (WHATSAPP_DEFAULT_MESSAGE=) for a link without prefilled text.
WHATSAPP_DEFAULT_MESSAGE="Hello, I would like more information about your products."

# --- PostgreSQL 16 ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-at-least-16-characters

# --- Images published by GitHub Actions to GHCR (D2) ---
BACKEND_IMAGE=ghcr.io/yassine-bhn/e-commerce
STOREFRONT_IMAGE=ghcr.io/yousseflimem/zidane-front-web
# Pinned release SHA; `deploy/release.sh <sha>` rewrites it, `deploy/rollback.sh` swaps it back.
IMAGE_TAG=latest
PREVIOUS_IMAGE_TAG=

# --- Backups (scripts/backup-db.sh) ---
BACKUP_RETENTION_DAYS=7
