    public function getSourceContext(): Source
    {
        return new Source("{% use \x27form_div_layout.html.twig\x27 %}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default(row_class|default(\x27mb-6\x27))}) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block widget_attributes -%}
    {%- set attr = attr|merge({class: attr.class|default(widget_class|default(\x27mt-1 w-full\x27)) ~ (disabled ? \x27 \x27 ~ widget_disabled_class|default(\x27border-gray-300 text-gray-500\x27)) ~ (errors|length ? \x27 \x27 ~ widget_errors_class|default(\x27border-red-700\x27))}) -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: label_attr.class|default(label_class|default(\x27block text-gray-800\x27))}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: help_attr.class|default(help_class|default(\x27mt-1 text-gray-600\x27))}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul>
            {%- for error in errors -%}
                <li class=\"{{ error_item_class|default(\x27text-red-700\x27) }}\" id=\"{{ id ~ \x27_error\x27 ~ loop.index }}\">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: attr.class|default(\x27mt-2\x27)}) -%}
    <div {{ block(\x27widget_container_attributes\x27) }}>
        {%- for child in form %}
            <div class=\"flex items-center\">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default(row_class|default(\x27mb-6\x27))}) -%}
    {%- set widget_attr = {} -%}
    {%- if help -%}
        {%- set widget_attr = {attr: {\x27aria-describedby\x27: id ~ \x27_help\x27}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}>
        {{- form_errors(form) -}}
        <div class=\"inline-flex items-center\">
            {{- form_widget(form, widget_attr) -}}
            {{- form_label(form) -}}
        </div>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default(\x27mr-2\x27) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    {%- set widget_class = widget_class|default(\x27mr-2\x27) -%}
    {{- parent() -}}
{%- endblock radio_widget -%}
", "tailwind_2_layout.html.twig", "/app/vendor/symfony/twig-bridge/Resources/views/Form/tailwind_2_layout.html.twig");
    }
}
