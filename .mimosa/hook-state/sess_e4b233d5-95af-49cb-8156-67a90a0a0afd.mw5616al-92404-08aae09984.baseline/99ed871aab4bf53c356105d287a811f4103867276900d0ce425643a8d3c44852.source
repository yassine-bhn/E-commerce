    public function getSourceContext(): Source
    {
        return new Source("<!DOCTYPE html>
<html>
<head>
    {% block meta %}
        <meta charset=\"UTF-8\">
        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">
    {% endblock meta %}
    <title>{% block title %}{{ swagger_data.spec.info.title }}{% endblock title %}</title>
</head>
<body>
    {% block swagger_ui %}
        <div id=\"scalar-api-reference\"></div>
        <script id=\"scalar-api-reference-data\" type=\"application/json\">{{ swagger_data.spec|json_encode(65)|raw }}</script>
    {% endblock swagger_ui %}
    {% block swagger_initialization %}
        {{ nelmioAsset(assets_mode, \x27scalar/scalar.standalone.js\x27) }}
        <script>
            Scalar.createApiReference(\x27#scalar-api-reference\x27, {
                title: {{ swagger_data.spec.info.title|default(\x27API\x27)|json_encode(65)|raw }},
                ...{{ scalar_config|json_encode(65)|raw }},
                content: JSON.parse(document.getElementById(\x27scalar-api-reference-data\x27).textContent),
            });
        </script>
    {% endblock swagger_initialization %}
</body>
</html>
", "@NelmioApiDoc/Scalar/index.html.twig", "/app/vendor/nelmio/api-doc-bundle/templates/Scalar/index.html.twig");
