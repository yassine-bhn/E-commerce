    public function getSourceContext(): Source
    {
        return new Source("<div id=\"sidebar-search\">
    <form action=\"{{ path(\x27_profiler_search\x27) }}\" method=\"get\">
        <div class=\"form-group\">
            <label for=\"ip\">
                {% if \x27command\x27 == profile_type %}
                    Application
                {% else %}
                    IP
                {% endif %}
            </label>
            <input type=\"text\" name=\"ip\" id=\"ip\" value=\"{{ ip }}\">
        </div>

        <div class=\"form-group-row\">
            <div class=\"form-group\">
                <label for=\"method\">
                    {% if \x27command\x27 == profile_type %}
                        Mode
                    {% else %}
                        Method
                    {% endif %}
                </label>
                <select name=\"method\" id=\"method\">
                    <option value=\"\">Any</option>
                    {% if \x27command\x27 == profile_type %}
                        {% set methods = [\x27BATCH\x27, \x27INTERACTIVE\x27] %}
                    {% else %}
                        {% set methods = [\x27DELETE\x27, \x27GET\x27, \x27HEAD\x27, \x27PATCH\x27, \x27POST\x27, \x27PUT\x27, \x27QUERY\x27] %}
                    {% endif %}
                    {% for m in methods %}
                        <option {{ m == method ? \x27selected=\"selected\"\x27 }}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class=\"form-group\">
                <label for=\"status_code\">
                    {% if \x27command\x27 == profile_type %}
                        Exit code
                        {% set min_and_max = \x27min=%d max=%d\x27|format(0, 255) %}
                    {% else %}
                        Status
                        {% set min_and_max = \x27min=%d max=%d\x27|format(100, 599) %}
                    {% endif %}
                </label>
                <input type=\"number\" name=\"status_code\" id=\"status_code\" {{ min_and_max }} value=\"{{ status_code }}\">
            </div>
        </div>

        <div class=\"form-group\">
            <label for=\"url\">
                {% if \x27command\x27 == profile_type %}
                    Command
                {% else %}
                    URL
                {% endif %}
            </label>
            <input type=\"text\" name=\"url\" id=\"url\" value=\"{{ url }}\">
        </div>

        <div class=\"form-group\">
            <label for=\"token\">Token</label>
            <input type=\"text\" name=\"token\" id=\"token\" size=\"8\" value=\"{{ token }}\">
        </div>

        <div class=\"form-group\">
            <label for=\"start\">From</label>
            <input type=\"date\" name=\"start\" id=\"start\" value=\"{{ start }}\">
        </div>

        <div class=\"form-group\">
            <label for=\"end\">Until</label>
            <input type=\"date\" name=\"end\" id=\"end\" value=\"{{ end }}\">
        </div>

        <div class=\"form-group-row form-group-row-search-button\">
            <div class=\"form-group\">
                <label for=\"limit\">Results</label>
                <select name=\"limit\" id=\"limit\">
                    {% for l in [10, 50, 100] %}
                        <option {{ l == limit ? \x27selected=\"selected\"\x27 }}>{{ l }}</option>
                    {% endfor %}
                </select>
            </div>

            <input type=\"hidden\" name=\"type\" value=\"{{ profile_type }}\">

            <div class=\"form-group\">
                <button type=\"submit\" class=\"btn btn-sm\">Search</button>
            </div>
        </div>
    </form>
</div>
", "@WebProfiler/Profiler/search.html.twig", "/app/vendor/symfony/web-profiler-bundle/Resources/views/Profiler/search.html.twig");
    }
}
