    public function getSourceContext(): Source
    {
        return new Source("{% extends \x27@WebProfiler/Profiler/layout.html.twig\x27 %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --workflow-dialog-background: var(--gray-200);
        }
        .theme-dark {
            --workflow-dialog-background: var(--gray-900);
        }

        dialog {
            background: var(--workflow-dialog-background);
            border: none;
            border-radius: 6px;
            box-shadow: var(--settings-modal-shadow);
            max-width: 94%;
            width: 1200px;
        }

        dialog::backdrop {
            background: linear-gradient(
                45deg,
                rgb(18, 18, 20, 0.4),
                rgb(17, 17, 20, 0.8)
            );
        }

        dialog[open] {
            animation: scale 0.3s ease normal;
        }

        dialog[open]::backdrop {
            animation: backdrop 0.3s ease normal;
        }

        dialog.hide {
            animation-direction: reverse;
        }

        dialog h2 {
            box-shadow: none !important;
            color: var(--page-color);
            font-size: 18px;
            margin: 0 0 .5em;
        }

        dialog i.cancel {
            cursor: pointer;
            padding: 0 5px;
            float: right;
        }

        dialog table {
            background: var(--page-background);
            border-collapse: collapse;
            border-radius: 4px;
            box-shadow: inset 0 0 0 1px var(--table-border-color);
            color: var(--page-color);
            margin: 0 0 1em 0;
            margin-bottom: 1em;
            padding: 0;
        }

        dialog table tr {
            border: 1px solid var(--table-border-color);
            padding: .35em;
        }

        dialog table th,
        dialog table td {
            border: 1px solid var(--table-border-color);
            padding: .625em;
            text-align: left;
            word-wrap: break-word;
        }

        dialog table thead th {
            background: var(--table-header);
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
            font-size: .85em;
        }

        dialog .dialog-buttons {
            display: none;
        }

        @keyframes scale {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }

        @keyframes backdrop {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
{% endblock %}

{% block toolbar %}
    {% if collector.callsCount > 0 %}
        {% set icon %}
            {{ source(\x27@WebProfiler/Icon/workflow.svg\x27) }}
            <span class=\"sf-toolbar-value\">{{ collector.callsCount }}</span>
        {% endset %}
        {% set text %}
            <div class=\"sf-toolbar-info-piece\">
                <b>Workflow Calls</b>
                <span>{{ collector.callsCount }}</span>
            </div>
        {% endset %}

        {{ include(\x27@WebProfiler/Profiler/toolbar_item.html.twig\x27, {link: profiler_url}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class=\"label {{ collector.workflows|length == 0 ? \x27disabled\x27 }}\">
        <span class=\"icon\" aria-hidden=\"true\">
            {{ source(\x27@WebProfiler/Icon/workflow.svg\x27) }}
        </span>
        <strong>Workflow</strong>
    </span>
{% endblock %}

{% block panel %}
    <h2>Workflow</h2>

    {% if collector.workflows|length == 0 %}
        <div class=\"empty empty-panel\">
            <p>There are no workflows configured.</p>
        </div>
    {% else %}
        <script>
            {{ source(\x27@WebProfiler/Script/Mermaid/mermaid-flowchart-v2.min.js\x27) }}
            const isDarkMode = document.querySelector(\x27body\x27).classList.contains(\x27theme-dark\x27);
            mermaid.initialize({
                flowchart: {
                    useMaxWidth: true,
                },
                securityLevel: \x27loose\x27,
                theme: \x27base\x27,
                themeVariables: {
                    darkMode: isDarkMode,
                    fontFamily: \x27var(--font-family-system)\x27,
                    fontSize: \x27var(--font-size-body)\x27,
                    // the properties below don\x27t support CSS variables
                    primaryColor: isDarkMode ? \x27lightsteelblue\x27 : \x27aliceblue\x27,
                    primaryTextColor: isDarkMode ? \x27#fff\x27 : \x27#000\x27,
                    primaryBorderColor: isDarkMode ? \x27steelblue\x27 : \x27lightsteelblue\x27,
                    lineColor: isDarkMode ? \x27#939393\x27 : \x27#d4d4d4\x27,
                    secondaryColor: isDarkMode ? \x27lightyellow\x27 : \x27lightyellow\x27,
                    tertiaryColor: isDarkMode ? \x27lightSalmon\x27 : \x27lightSalmon\x27,
                }
            });

            {% for name, data in collector.workflows %}
                window.showNodeDetails{{ collector.hash(name) }} = function (node) {
                    const map = {{ data.listeners|json_encode(constant(\x27JSON_HEX_TAG\x27))|raw }};
                    showNodeDetails(node, map);
                };
            {% endfor %}

            const showNodeDetails = function (node, map) {
                const dialog = document.getElementById(\x27detailsDialog\x27);

                dialog.querySelector(\x27tbody\x27).innerHTML = \x27\x27;
                for (const [eventName, listeners] of Object.entries(map[node])) {
                    listeners.forEach(listener => {
                        const row = document.createElement(\x27tr\x27);

                        const eventNameCode = document.createElement(\x27code\x27);
                        eventNameCode.textContent = eventName;

                        const eventNameCell = document.createElement(\x27td\x27);
                        eventNameCell.appendChild(eventNameCode);
                        row.appendChild(eventNameCell);

                        const listenerDetailsCell = document.createElement(\x27td\x27);
                        row.appendChild(listenerDetailsCell);

                        let listenerDetails;
                        const listenerDetailsCode = document.createElement(\x27code\x27);
                        listenerDetailsCode.textContent = listener.title;
                        if (listener.file) {
                            const link = document.createElement(\x27a\x27);
                            link.href = listener.file;
                            link.appendChild(listenerDetailsCode);
                            listenerDetails = link;
                        } else {
                            listenerDetails = listenerDetailsCode;
                        }
                        listenerDetailsCell.appendChild(listenerDetails);

                        if (typeof listener.guardExpressions === \x27object\x27) {
                            listenerDetailsCell.appendChild(document.createElement(\x27br\x27));

                            const guardExpressionsWrapper = document.createElement(\x27span\x27);
                            guardExpressionsWrapper.appendChild(document.createTextNode(\x27guard expressions: \x27));

                            listener.guardExpressions.forEach((expression, index) => {
                                if (index > 0) {
                                    guardExpressionsWrapper.appendChild(document.createTextNode(\x27, \x27));
                                }

                                const expressionCode = document.createElement(\x27code\x27);
                                expressionCode.textContent = expression;
                                guardExpressionsWrapper.appendChild(expressionCode);
                            });

                            listenerDetailsCell.appendChild(guardExpressionsWrapper);
                        }

                        dialog.querySelector(\x27tbody\x27).appendChild(row);
                    });
                };

                if (dialog.dataset.processed) {
                    dialog.showModal();
                    return;
                }

                dialog.addEventListener(\x27click\x27, (e) => {
                    const rect = dialog.getBoundingClientRect();

                    const inDialog =
                        rect.top <= e.clientY &&
                        e.clientY <= rect.top + rect.height &&
                        rect.left <= e.clientX &&
                        e.clientX <= rect.left + rect.width;

                    !inDialog && dialog.close();
                });

                dialog.querySelectorAll(\x27.cancel\x27).forEach(elt => {
                    elt.addEventListener(\x27click\x27, () => dialog.close());
                });

                dialog.showModal();

                dialog.dataset.processed = true;
            };
            // We do not load all mermaid diagrams at once, but only when the tab is opened
            // This is because mermaid diagrams are in a tab, and cannot be rendered with a
            // \"good size\" if they are not visible
            document.addEventListener(\x27DOMContentLoaded\x27, () => {
                document.querySelectorAll(\x27.tab\x27).forEach((el) => {
                    const observer = new MutationObserver(() => {
                        if (!el.classList.contains(\x27block\x27)) {
                            return;
                        }
                        const mEl = el.querySelector(\x27.sf-mermaid\x27);
                        if (mEl.dataset.processed) {
                            return;
                        }
                        mermaid.run({
                            nodes: [mEl],
                        });
                    });
                    observer.observe(el, { attributeFilter: [\x27class\x27] });
                });
            });
        </script>

        <div class=\"sf-tabs js-tabs\">
            {% for name, data in collector.workflows %}
                <div class=\"tab\">
                    <h2 class=\"tab-title\">{{ name }}{% if data.calls|length %} ({{ data.calls|length }}){% endif %}</h2>

                    <div class=\"tab-content\">
                        <h3>Definition</h3>
                        <pre class=\"sf-mermaid\">
                            {{ data.dump }}
                            {% for nodeId, events in data.listeners %}
                                click {{ nodeId }} showNodeDetails{{ collector.hash(name) }}
                            {% endfor %}
                        </pre>
                        <a href=\"{{ collector.buildMermaidLiveLink(name) }}\">View on mermaid.live</a>

                        <h3>Calls</h3>
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Call</th>
                                    <th>Args</th>
                                    <th>Return</th>
                                    <th>Exception</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for call in data.calls %}
                                    <tr>
                                        <td class=\"font-normal text-small text-muted nowrap\">{{ loop.index }}</td>
                                        <td>
                                            <code>{{ call.method }}()</code>
                                            {% if call.previousMarking ?? null %}
                                                <hr />
                                                Previous marking:
                                                {{ profiler_dump(call.previousMarking) }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {{ profiler_dump(call.args) }}
                                        </td>
                                        <td>
                                            {% if call.return is defined %}
                                                {% if call.return is same as true %}
                                                    <code>true</code>
                                                {% elseif call.return is same as false %}
                                                    <code>false</code>
                                                {% else %}
                                                    {{ profiler_dump(call.return) }}
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if call.exception is defined %}
                                                {{ profiler_dump(call.exception) }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {{ \x27%0.2f ms\x27|format(call.duration) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <dialog id=\"detailsDialog\" aria-labelledby=\"workflow-dialog-title\">
        <h2 id=\"workflow-dialog-title\">
            Event listeners
            <i class=\"cancel\">×</i>
        </h2>

        <table>
            <thead>
                <tr>
                    <th>event</th>
                    <th>listener</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <footer class=\"dialog-buttons\">
            <small><i>⌨</i> <kbd>esc</kbd></small>
            <button class=\"btn btn-sm cancel\">Close</button>
        </footer>
    </dialog>
{% endblock %}
", "@WebProfiler/Collector/workflow.html.twig", "/app/vendor/symfony/web-profiler-bundle/Resources/views/Collector/workflow.html.twig");
    }
}
