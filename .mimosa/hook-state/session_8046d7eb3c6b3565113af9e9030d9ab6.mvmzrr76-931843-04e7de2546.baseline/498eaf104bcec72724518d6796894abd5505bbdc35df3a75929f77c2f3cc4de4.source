    public function getSourceContext(): Source
    {
        return new Source("{% extends \x27@WebProfiler/Profiler/base.html.twig\x27 %}

{% block body %}
    <div class=\"container\">
        {{ include(\x27@WebProfiler/Profiler/header.html.twig\x27, {profile_type: profile_type}, with_context: false) }}

        <div id=\"summary\">
        {% block summary %}
            {% if profile is defined %}
                {% set request_collector = profile.collectors.request|default(false) %}

                {{ include(\x27@WebProfiler/Profiler/_%s_summary.html.twig\x27|format(profile_type), {
                    profile: profile,
                    command_collector: profile.collectors.command|default(false),
                    request_collector: request_collector,
                    request: request,
                    token: token,
                }, with_context: false) }}
            {% endif %}
        {% endblock %}
    </div>

        <div id=\"content\">
            <main id=\"main\">
                <div id=\"sidebar\">
                    {% block sidebar %}
                        <div id=\"sidebar-contents\">
                            <div id=\"sidebar-shortcuts\">
                                {% block sidebar_shortcuts_links %}
                                    <div class=\"shortcuts\">
                                        <a class=\"btn btn-link\" href=\"{{ path(\x27_profiler_search\x27, {limit: 10, type: profile_type}) }}\">{{ source(\x27@WebProfiler/Icon/search.svg\x27) }} Search profiles</a>
                                        <a class=\"btn btn-link\" href=\"{{ path(\x27_profiler\x27, {token: \x27latest\x27, type: profile_type}|merge(request.query.all)) }}\">Latest</a>
                                    </div>
                                {% endblock sidebar_shortcuts_links %}
                            </div>

                            {% if templates is defined %}
                                <nav aria-label=\"Profiler menu\">
                                <ul id=\"menu-profiler\">
                                    {% if \x27request\x27 is same as(profile_type) %}
                                        {% set excludes = [\x27command\x27] %}
                                    {% elseif \x27command\x27 is same as(profile_type) %}
                                        {% set excludes = [\x27request\x27, \x27router\x27] %}
                                    {% endif %}

                                    {% for name, template in templates|filter((t, n) => n not in excludes) %}
                                        {% set menu -%}
                                            {%- if block(\x27menu\x27, template) is defined -%}
                                                {% with {collector: profile.getcollector(name), profiler_markup_version: profiler_markup_version} %}
                                                    {{- block(\x27menu\x27, template) -}}
                                                {% endwith %}
                                            {%- endif -%}
                                        {%- endset %}
                                        {% if menu is not empty %}
                                            <li class=\"{{ name }} {{ name == panel ? \x27selected\x27 }}\">
                                                <a href=\"{{ path(\x27_profiler\x27, {token: token, panel: name, type: profile_type}) }}\"{{ name == panel ? \x27 aria-current=\"page\"\x27 }}>{{ menu|raw }}</a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                                </nav>
                            {% endif %}
                        </div>

                        {{ include(\x27@WebProfiler/Profiler/settings.html.twig\x27) }}
                    {% endblock sidebar %}
                </div>

                <div id=\"collector-wrapper\">
                    <div id=\"collector-content\">
                        {{ include(\x27@WebProfiler/Profiler/base_js.html.twig\x27) }}
                        {% block panel \x27\x27 %}
                    </div>
                </div>
            </main>
        </div>
    </div>
{% endblock %}
", "@WebProfiler/Profiler/layout.html.twig", "/app/vendor/symfony/web-profiler-bundle/Resources/views/Profiler/layout.html.twig");
    }
}
