    'The audio is too long ({{ duration }} seconds). Allowed maximum duration is {{ max_duration }} seconds.' => 'آڈیو بہت طویل ہے ({{ duration }} سیکنڈ)۔ اجازت شدہ زیادہ سے زیادہ دورانیہ {{ max_duration }} سیکنڈ ہے۔',
    'The duration of the audio could not be detected.' => 'آڈیو کا دورانیہ معلوم نہیں کیا جا سکا۔',
    'The audio bitrate is too low ({{ bitrate }} bps). Minimum bitrate expected is {{ min_bitrate }} bps.' => 'آڈیو کی بٹ ریٹ بہت کم ہے ({{ bitrate }} bps)۔ متوقع کم از کم بٹ ریٹ {{ min_bitrate }} bps ہے۔',
    'The audio bitrate is too high ({{ bitrate }} bps). Allowed maximum bitrate is {{ max_bitrate }} bps.' => 'آڈیو کی بٹ ریٹ بہت زیادہ ہے ({{ bitrate }} bps)۔ اجازت شدہ زیادہ سے زیادہ بٹ ریٹ {{ max_bitrate }} bps ہے۔',
