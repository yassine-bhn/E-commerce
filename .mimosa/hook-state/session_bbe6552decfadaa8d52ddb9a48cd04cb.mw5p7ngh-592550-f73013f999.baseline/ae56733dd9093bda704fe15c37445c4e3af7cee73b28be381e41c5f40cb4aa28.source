    'The audio has too many channels ({{ channels }}). Maximum amount expected is {{ max_channels }}.' => 'آڈیو میں چینلز بہت زیادہ ہیں ({{ channels }})۔ متوقع زیادہ سے زیادہ مقدار {{ max_channels }} ہے۔',
