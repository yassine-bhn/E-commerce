    public function getSourceContext(): Source
    {
        return new Source("{% extends \x27form_div_layout.html.twig\x27 %}

{%- block checkbox_row -%}
    {%- set parent_class = parent_class|default(attr.class|default(\x27\x27)) -%}
    {%- if \x27switch-input\x27 in parent_class -%}
        {{- form_label(form) -}}
        {%- set attr = attr|merge({class: (attr.class|default(\x27\x27) ~ \x27 switch-input\x27)|trim}) -%}
        {{- form_widget(form) -}}
        <label class=\"switch-paddle\" for=\"{{ form.vars.id }}\"></label>
        {{- form_errors(form) -}}
    {%- else -%}
        {{- block(\x27form_row\x27) -}}
    {%- endif -%}
{%- endblock checkbox_row -%}

{% block money_widget -%}
    {% set prepend = not (money_pattern starts with \x27{{\x27) %}
    {% set append = not (money_pattern ends with \x27}}\x27) %}
    {% if prepend or append %}
        <div class=\"input-group\">
            {% if prepend %}
                <span class=\"input-group-label\">{{ money_pattern|form_encode_currency }}</span>
            {% endif %}
            {% set attr = attr|merge({class: (attr.class|default(\x27\x27) ~ \x27 input-group-field\x27)|trim}) %}
            {{- block(\x27form_widget_simple\x27) -}}
            {% if append %}
                <span class=\"input-group-label\">{{ money_pattern|form_encode_currency }}</span>
            {% endif %}
        </div>
    {% else %}
        {{- block(\x27form_widget_simple\x27) -}}
    {% endif %}
{%- endblock money_widget %}

{% block percent_widget -%}
    {%- if symbol -%}
        <div class=\"input-group\">
            {% set attr = attr|merge({class: (attr.class|default(\x27\x27) ~ \x27 input-group-field\x27)|trim}) %}
            {{- block(\x27form_widget_simple\x27) -}}
            <span class=\"input-group-label\">{{ symbol|default(\x27%\x27) }}</span>
        </div>
    {%- else -%}
        {{- block(\x27form_widget_simple\x27) -}}
    {%- endif -%}
{%- endblock percent_widget %}

{% block button_widget -%}
    {% set attr = attr|merge({class: (attr.class|default(\x27\x27) ~ \x27 button\x27)|trim}) %}
    {{- parent() -}}
{%- endblock button_widget %}
", "foundation_6_layout.html.twig", "/app/vendor/symfony/twig-bridge/Resources/views/Form/foundation_6_layout.html.twig");
    }
}
