,  127 => 64,  124 => 63,  121 => 61,  119 => 57,  116 => 56,  114 => 46,  111 => 45,  109 => 35,  106 => 34,  104 => 17,  101 => 16,  99 => 12,  96 => 11,  94 => 5,  91 => 4,  88 => 2,  42 => 1,);
