 386,  193 => 380,  191 => 374,  189 => 365,  187 => 346,  185 => 338,  182 => 335,  180 => 320,  177 => 319,  175 => 311,  172 => 310,  170 => 307,  168 => 281,  166 => 267,  164 => 254,  162 => 249,  160 => 244,  158 => 239,  156 => 234,  154 => 228,  152 => 223,  150 => 218,  148 => 213,  146 => 208,  144 => 203,  142 => 198,  140 => 193,  138 => 189,  136 => 184,  134 => 178,  132 => 143,  130 => 132,  128 => 118,  126 => 105,  124 => 101,  122 => 97,  120 => 84,  118 => 58,  116 => 49,  114 => 41,  112 => 37,  110 => 30,  108 => 20,  106 => 11,  104 => 3,);
    }

    public function getSourceContext(): Source
    {
        return new Source("{# Widgets #}

{%- block form_widget -%}
    {% if compound %}
        {{- block(\x27form_widget_compound\x27) -}}
    {% else %}
        {{- block(\x27form_widget_simple\x27) -}}
    {% endif %}
{%- endblock form_widget -%}

{%- block form_widget_simple -%}
    {%- set type = type|default(\x27text\x27) -%}
    {%- if type == \x27range\x27 or type == \x27color\x27 -%}
        {# Attribute \"required\" is not supported #}
        {%- set required = false -%}
    {%- endif -%}
    <input type=\"{{ type }}\" {{ block(\x27widget_attributes\x27) }} {% if value is not empty %}value=\"{{ value }}\" {% endif %}/>
{%- endblock form_widget_simple -%}

{%- block form_widget_compound -%}
    <div {{ block(\x27widget_container_attributes\x27) }}>
        {%- if form is rootform -%}
            {{ form_errors(form) }}
        {%- endif -%}
        {{- block(\x27form_rows\x27) -}}
        {{- form_rest(form) -}}
    </div>
{%- endblock form_widget_compound -%}

{%- block collection_widget -%}
    {% if prototype is defined and not prototype.rendered %}
        {%- set attr = attr|merge({\x27data-prototype\x27: form_row(prototype)}) -%}
    {% endif %}
    {{- block(\x27form_widget\x27) -}}
{%- endblock collection_widget -%}

{%- block textarea_widget -%}
    <textarea {{ block(\x27widget_attributes\x27) }}>{{ value }}</textarea>
{%- endblock textarea_widget -%}

{%- block choice_widget -%}
    {% if expanded %}
        {{- block(\x27choice_widget_expanded\x27) -}}
    {% else %}
        {{- block(\x27choice_widget_collapsed\x27) -}}
    {% endif %}
{%- endblock choice_widget -%}

{%- block choice_widget_expanded -%}
    <div {{ block(\x27widget_container_attributes\x27) }}>
    {%- for child in form %}
        {{- form_widget(child) -}}
        {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
    {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block choice_widget_collapsed -%}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple and (attr.size is not defined or attr.size <= 1) -%}
        {% set required = false %}
    {%- endif -%}
    <select {{ block(\x27widget_attributes\x27) }}{% if multiple %} multiple=\"multiple\"{% endif %}>
        {%- if placeholder is not none -%}
            <option value=\"\"{% if placeholder_attr|default({}) %}{% with {attr: placeholder_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}{% endif %}{% if required and value is empty %} selected=\"selected\"{% endif %}>{{ placeholder != \x27\x27 ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
        {%- endif -%}
        {%- if preferred_choices|length > 0 -%}
            {% set options = preferred_choices %}
            {% set render_preferred_choices = true %}
            {{- block(\x27choice_widget_options\x27) -}}
            {%- if choices|length > 0 and separator is not none -%}
                {%- if separator_html is not defined or separator_html is same as(false) -%}
                    <option disabled=\"disabled\">{{ separator }}</option>
                {% else %}
                    {{ separator|raw }}
                {% endif %}
            {%- endif -%}
        {%- endif -%}
        {%- set options = choices -%}
        {%- set render_preferred_choices = false -%}
        {{- block(\x27choice_widget_options\x27) -}}
    </select>
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_options -%}
    {% for group_label, choice in options %}
        {%- if choice is iterable -%}
            <optgroup label=\"{{ choice_translation_domain is same as(false) ? group_label : group_label|trans({}, choice_translation_domain) }}\">
                {% set options = choice %}
                {{- block(\x27choice_widget_options\x27) -}}
            </optgroup>
        {%- else -%}
            <option value=\"{{ choice.value }}\"{% if choice.attr %}{% with {attr: choice.attr} %}{{ block(\x27attributes\x27) }}{% endwith %}{% endif %}{% if (not render_preferred_choices|default(false) or not (duplicate_preferred_choices ?? true)) and choice is selectedchoice(value) %} selected=\"selected\"{% endif %}>{{ choice_translation_domain is same as(false) ? choice.label : choice.label|trans(choice.labelTranslationParameters, choice_translation_domain) }}</option>
        {%- endif -%}
    {% endfor %}
{%- endblock choice_widget_options -%}

{%- block checkbox_widget -%}
    <input type=\"checkbox\" {{ block(\x27widget_attributes\x27) }}{% if value is defined %} value=\"{{ value }}\"{% endif %}{% if checked %} checked=\"checked\"{% endif %} />
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    <input type=\"radio\" {{ block(\x27widget_attributes\x27) }}{% if value is defined %} value=\"{{ value }}\"{% endif %}{% if checked %} checked=\"checked\"{% endif %} />
{%- endblock radio_widget -%}

{%- block datetime_widget -%}
    {% if widget == \x27single_text\x27 %}
        {{- block(\x27form_widget_simple\x27) -}}
    {%- else -%}
        <div {{ block(\x27widget_container_attributes\x27) }}>
            {{- form_errors(form.date) -}}
            {{- form_errors(form.time) -}}
            {{- form_widget(form.date) -}}
            {{- form_widget(form.time) -}}
        </div>
    {%- endif -%}
{%- endblock datetime_widget -%}

{%- block date_widget -%}
    {%- if widget == \x27single_text\x27 -%}
        {{ block(\x27form_widget_simple\x27) }}
    {%- else -%}
        <div {{ block(\x27widget_container_attributes\x27) }}>
            {{- date_pattern|replace({
                \x27{{ year }}\x27: form_widget(form.year),
                \x27{{ month }}\x27: form_widget(form.month),
                \x27{{ day }}\x27: form_widget(form.day),
            })|raw -}}
        </div>
    {%- endif -%}
{%- endblock date_widget -%}

{%- block time_widget -%}
    {%- if widget == \x27single_text\x27 -%}
        {{ block(\x27form_widget_simple\x27) }}
    {%- else -%}
        {%- set vars = widget == \x27text\x27 ? {attr: {size: 1}} : {} -%}
        <div {{ block(\x27widget_container_attributes\x27) }}>
            {{ form_widget(form.hour, vars) }}{% if with_minutes %}:{{ form_widget(form.minute, vars) }}{% endif %}{% if with_seconds %}:{{ form_widget(form.second, vars) }}{% endif %}
        </div>
    {%- endif -%}
{%- endblock time_widget -%}

{%- block dateinterval_widget -%}
    {%- if widget == \x27single_text\x27 -%}
        {{- block(\x27form_widget_simple\x27) -}}
    {%- else -%}
        <div {{ block(\x27widget_container_attributes\x27) }}>
            {{- form_errors(form) -}}
            <table class=\"{{ table_class|default(\x27\x27) }}\" role=\"presentation\">
                <thead>
                    <tr>
                        {%- if with_years %}<th>{{ form_label(form.years) }}</th>{% endif -%}
                        {%- if with_months %}<th>{{ form_label(form.months) }}</th>{% endif -%}
                        {%- if with_weeks %}<th>{{ form_label(form.weeks) }}</th>{% endif -%}
                        {%- if with_days %}<th>{{ form_label(form.days) }}</th>{% endif -%}
                        {%- if with_hours %}<th>{{ form_label(form.hours) }}</th>{% endif -%}
                        {%- if with_minutes %}<th>{{ form_label(form.minutes) }}</th>{% endif -%}
                        {%- if with_seconds %}<th>{{ form_label(form.seconds) }}</th>{% endif -%}
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {%- if with_years %}<td>{{ form_widget(form.years) }}</td>{% endif -%}
                        {%- if with_months %}<td>{{ form_widget(form.months) }}</td>{% endif -%}
                        {%- if with_weeks %}<td>{{ form_widget(form.weeks) }}</td>{% endif -%}
                        {%- if with_days %}<td>{{ form_widget(form.days) }}</td>{% endif -%}
                        {%- if with_hours %}<td>{{ form_widget(form.hours) }}</td>{% endif -%}
                        {%- if with_minutes %}<td>{{ form_widget(form.minutes) }}</td>{% endif -%}
                        {%- if with_seconds %}<td>{{ form_widget(form.seconds) }}</td>{% endif -%}
                    </tr>
                </tbody>
            </table>
            {%- if with_invert %}{{ form_widget(form.invert) }}{% endif -%}
        </div>
    {%- endif -%}
{%- endblock dateinterval_widget -%}

{%- block number_widget -%}
    {# type=\"number\" doesn\x27t work with floats in localized formats #}
    {%- set type = type|default(\x27text\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock number_widget -%}

{%- block integer_widget -%}
    {%- set type = type|default(\x27number\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock integer_widget -%}

{%- block money_widget -%}
    {{ money_pattern|form_encode_currency(block(\x27form_widget_simple\x27)) }}
{%- endblock money_widget -%}

{%- block url_widget -%}
    {%- set type = type|default(\x27url\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock url_widget -%}

{%- block search_widget -%}
    {%- set type = type|default(\x27search\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock search_widget -%}

{%- block percent_widget -%}
    {%- set type = type|default(\x27text\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}{% if symbol %} {{ symbol|default(\x27%\x27) }}{% endif %}
{%- endblock percent_widget -%}

{%- block password_widget -%}
    {%- set type = type|default(\x27password\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock password_widget -%}

{%- block hidden_widget -%}
    {%- set type = type|default(\x27hidden\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock hidden_widget -%}

{%- block email_widget -%}
    {%- set type = type|default(\x27email\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock email_widget -%}

{%- block range_widget -%}
    {% set type = type|default(\x27range\x27) %}
    {{- block(\x27form_widget_simple\x27) -}}
{%- endblock range_widget %}

{%- block button_widget -%}
    <button type=\"{{ type|default(\x27button\x27) }}\" {{ block(\x27button_attributes\x27) }}>
        {{- block(\x27form_label_content\x27) -}}
    </button>
{%- endblock button_widget -%}

{%- block submit_widget -%}
    {%- set type = type|default(\x27submit\x27) -%}
    {{ block(\x27button_widget\x27) }}
{%- endblock submit_widget -%}

{%- block reset_widget -%}
    {%- set type = type|default(\x27reset\x27) -%}
    {{ block(\x27button_widget\x27) }}
{%- endblock reset_widget -%}

{%- block tel_widget -%}
    {%- set type = type|default(\x27tel\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock tel_widget -%}

{%- block color_widget -%}
    {%- set type = type|default(\x27color\x27) -%}
    {{ block(\x27form_widget_simple\x27) }}
{%- endblock color_widget -%}

{%- block week_widget -%}
    {%- if widget == \x27single_text\x27 -%}
        {{ block(\x27form_widget_simple\x27) }}
    {%- else -%}
        {%- set vars = widget == \x27text\x27 ? {attr: {size: 1}} : {} -%}
        <div {{ block(\x27widget_container_attributes\x27) }}>
            {{ form_widget(form.year, vars) }}-{{ form_widget(form.week, vars) }}
        </div>
    {%- endif -%}
{%- endblock week_widget -%}

{# Labels #}

{%- block form_label -%}
    {% if label is not same as(false) -%}
        {% if not compound -%}
            {% set label_attr = label_attr|merge({for: id}) %}
        {%- endif -%}
        {% if required -%}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default(\x27\x27) ~ \x27 required\x27)|trim}) %}
        {%- endif -%}
        <{{ element|default(\x27label\x27) }}{% if label_attr %}{% with {attr: label_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}{% endif %}>
            {{- block(\x27form_label_content\x27) -}}
        </{{ element|default(\x27label\x27) }}>
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {%- if label is null or label is same as(\x27\x27) -%}
        {%- if label_format is not empty -%}
            {% set label = label_format|replace({
                \x27%name%\x27: name,
                \x27%id%\x27: id,
            }) %}
        {%- elseif \x27button\x27 not in block_prefixes or label is not same as(false) -%}
            {% set label = name|humanize %}
        {%- endif -%}
    {%- endif -%}
    {%- if translation_domain is same as(false) -%}
        {%- if label_html is same as(false) -%}
            {{- label -}}
        {%- else -%}
            {{- label|raw -}}
        {%- endif -%}
    {%- else -%}
        {%- if label_html is same as(false) -%}
            {{- label|trans(label_translation_parameters, translation_domain) -}}
        {%- else -%}
            {{- label|trans(label_translation_parameters, translation_domain)|raw -}}
        {%- endif -%}
    {%- endif -%}
{%- endblock form_label_content -%}

{%- block button_label -%}{%- endblock -%}

{# Help #}

{% block form_help -%}
    {%- if help -%}
        {%- set help_attr = help_attr|merge({class: (help_attr.class|default(\x27\x27) ~ \x27 help-text\x27)|trim}) -%}
        <{{ element|default(\x27div\x27) }} id=\"{{ id }}_help\"{% with {attr: help_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}>
            {{- block(\x27form_help_content\x27) -}}
        </{{ element|default(\x27div\x27) }}>
    {%- endif -%}
{%- endblock form_help %}

{% block form_help_content -%}
    {%- if translation_domain is same as(false) -%}
        {%- if help_html is same as(false) -%}
            {{- help -}}
        {%- else -%}
            {{- help|raw -}}
        {%- endif -%}
    {%- else -%}
        {%- if help_html is same as(false) -%}
            {{- help|trans(help_translation_parameters, translation_domain) -}}
        {%- else -%}
            {{- help|trans(help_translation_parameters, translation_domain)|raw -}}
        {%- endif -%}
    {%- endif -%}
{%- endblock form_help_content %}

{# Rows #}

{%- block repeated_row -%}
    {#
    No need to render the errors here, as all errors are mapped
    to the first child (see RepeatedTypeValidatorExtension).
    #}
    {{- block(\x27form_rows\x27) -}}
{%- endblock repeated_row -%}

{%- block form_row -%}
    {%- set attr = {} -%}
    {%- set aria_describedby = [] -%}
    {%- if help -%}
        {%- set aria_describedby = aria_describedby|merge([id ~ \x27_help\x27]) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set aria_describedby = aria_describedby|merge(errors|map((_, index) => id ~ \x27_error\x27 ~ (index + 1))) -%}
    {%- endif -%}
    {%- if aria_describedby|length > 0 -%}
        {%- set attr = attr|merge({\x27aria-describedby\x27: aria_describedby|join(\x27 \x27)}) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({\x27aria-invalid\x27: \x27true\x27}) -%}
    {%- endif -%}
    {%- set widget_attr = {attr: attr} -%}
    {{- block(\x27form_row_render\x27) -}}
{%- endblock form_row -%}

{%- block form_row_render -%}
    <div{% with {attr: row_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_errors(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row_render -%}

{%- block button_row -%}
    <div{% with {attr: row_attr} %}{{ block(\x27attributes\x27) }}{% endwith %}>
        {{- form_widget(form) -}}
    </div>
{%- endblock button_row -%}

{%- block hidden_row -%}
    {{ form_widget(form) }}
{%- endblock hidden_row -%}

{# Misc #}

{%- block form -%}
    {{ form_start(form) }}
        {{- form_widget(form) -}}
    {{ form_end(form) }}
{%- endblock form -%}

{%- block form_start -%}
    {%- do form.setMethodRendered() -%}
    {% set method = method|upper %}
    {%- if method in [\x27GET\x27, \x27POST\x27] -%}
        {% set form_method = method %}
    {%- else -%}
        {% set form_method = \x27POST\x27 %}
    {%- endif -%}
    <form{% if name != \x27\x27 %} name=\"{{ name }}\"{% endif %} method=\"{{ form_method|lower }}\"{% if action != \x27\x27 %} action=\"{{ action }}\"{% endif %}{{ block(\x27attributes\x27) }}{% if multipart %} enctype=\"multipart/form-data\"{% endif %}>
    {%- if form_method != method -%}
        <input type=\"hidden\" name=\"_method\" value=\"{{ method }}\" />
    {%- endif -%}
{%- endblock form_start -%}

{%- block form_end -%}
    {%- if not render_rest is defined or render_rest -%}
        {{ form_rest(form) }}
    {%- endif -%}
    </form>
{%- endblock form_end -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
    <ul>
        {%- for error in errors -%}
            <li id=\"{{ id ~ \x27_error\x27 ~ loop.index }}\">{{ error.message }}</li>
        {%- endfor -%}
    </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_rest -%}
    {% for child in form -%}
        {% if not child.rendered %}
            {{- form_row(child) -}}
        {% endif %}
    {%- endfor -%}

    {% if not form.methodRendered and form is rootform %}
        {%- do form.setMethodRendered() -%}
        {% set method = method|upper %}
        {%- if method in [\x27GET\x27, \x27POST\x27] -%}
            {% set form_method = method %}
        {%- else -%}
            {% set form_method = \x27POST\x27 %}
        {%- endif -%}

        {%- if form_method != method -%}
            <input type=\"hidden\" name=\"_method\" value=\"{{ method }}\" />
        {%- endif -%}
    {% endif -%}
{% endblock form_rest %}

{# Support #}

{%- block form_rows -%}
    {% for child in form|filter(child => not child.rendered) %}
        {{- form_row(child) -}}
    {% endfor %}
{%- endblock form_rows -%}

{%- block widget_attributes -%}
    id=\"{{ id }}\" name=\"{{ full_name }}\"
    {%- if disabled %} disabled=\"disabled\"{% endif -%}
    {%- if required %} required=\"required\"{% endif -%}
    {{ block(\x27attributes\x27) }}
{%- endblock widget_attributes -%}

{%- block widget_container_attributes -%}
    {%- if id is not empty %}id=\"{{ id }}\"{% endif -%}
    {{ block(\x27attributes\x27) }}
{%- endblock widget_container_attributes -%}

{%- block button_attributes -%}
    id=\"{{ id }}\" name=\"{{ full_name }}\"{% if disabled %} disabled=\"disabled\"{% endif -%}
    {{ block(\x27attributes\x27) }}
{%- endblock button_attributes -%}

{% block attributes -%}
    {%- for attrname, attrvalue in attr -%}
        {{- \x27 \x27 -}}
        {%- if attrname in [\x27placeholder\x27, \x27title\x27] -%}
            {{- attrname }}=\"{{ translation_domain is same as(false) or attrvalue is null ? attrvalue : attrvalue|trans(attr_translation_parameters, translation_domain) }}\"
        {%- elseif attrvalue is same as(true) -%}
            {{- attrname }}=\"{{ attrname }}\"
        {%- elseif attrvalue is not same as(false) -%}
            {{- attrname }}=\"{{ attrvalue }}\"
        {%- endif -%}
    {%- endfor -%}
{%- endblock attributes -%}
", "form_div_layout.html.twig", "/app/vendor/symfony/twig-bridge/Resources/views/Form/form_div_layout.html.twig");
    }
}
