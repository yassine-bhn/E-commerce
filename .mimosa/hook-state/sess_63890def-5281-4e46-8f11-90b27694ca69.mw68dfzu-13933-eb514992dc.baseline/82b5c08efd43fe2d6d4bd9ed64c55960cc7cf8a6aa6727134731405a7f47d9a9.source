    public function getSourceContext(): Source
    {
        return new Source("{% extends \x27@WebProfiler/Profiler/layout.html.twig\x27 %}

{% block toolbar %}
    {% set icon %}
        {% set status_color = (collector.memory / 1024 / 1024) > 50 ? \x27yellow\x27 %}
        {{ source(\x27@WebProfiler/Icon/memory.svg\x27) }}
        <span class=\"sf-toolbar-value\">{{ \x27%.1f\x27|format(collector.memory / 1024 / 1024) }}</span>
        <span class=\"sf-toolbar-label\">MiB</span>
    {% endset %}

    {% set text %}
        <div class=\"sf-toolbar-info-piece\">
            <b>Peak memory usage</b>
            <span>{{ \x27%.1f\x27|format(collector.memory / 1024 / 1024) }} MiB</span>
        </div>

        <div class=\"sf-toolbar-info-piece\">
            <b>PHP memory limit</b>
            <span>{{ collector.memoryLimit == -1 ? \x27Unlimited\x27 : \x27%.0f MiB\x27|format(collector.memoryLimit / 1024 / 1024) }}</span>
        </div>
    {% endset %}

    {{ include(\x27@WebProfiler/Profiler/toolbar_item.html.twig\x27, {link: profiler_url, name: \x27time\x27, status: status_color}) }}
{% endblock %}
", "@WebProfiler/Collector/memory.html.twig", "/app/vendor/symfony/web-profiler-bundle/Resources/views/Collector/memory.html.twig");
