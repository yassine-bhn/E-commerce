# INF-001: test env uses PostgreSQL (same engine as prod), not SQLite.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=16&charset=utf8"
# R1 — the WhatsApp contact is configuration-driven, so the test environment declares the same
# keys as .env. Digits only, international format, optional single leading "+".
WHATSAPP_PHONE_NUMBER=21600000000
WHATSAPP_DEFAULT_MESSAGE="Hello, I would like more information about your products."
